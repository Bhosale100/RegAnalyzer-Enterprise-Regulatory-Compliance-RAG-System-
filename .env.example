# Regulatory Compliance RAG Engine — Environment Configuration
# Copy this file to .env and fill in your values

# ── Google Gemini ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── PostgreSQL (pgvector) ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erc_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ── Application Settings ─────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── RAG Pipeline Tuning ──────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DENSE_TOP_K=15
SPARSE_TOP_K=15
RERANK_TOP_N=6
COSINE_FLOOR=0.50
CROSS_ENCODER_FLOOR=0.0
EMBEDDING_MODEL=models/text-embedding-004
LLM_PRIMARY=gemini-2.5-flash
LLM_FALLBACK_1=gemini-2.0-flash
LLM_FALLBACK_2=gemini-1.5-flash-latest
PGVECTOR_COLLECTION=erc_compliance_chunks
